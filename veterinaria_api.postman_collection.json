{
  "info": {
    "_postman_id": "c1f7a420-9999-4b8c-a111-veterinaria-api",
    "name": "Clínica Veterinaria API (Spring Boot 3 + PostgreSQL)",
    "description": "Colección completa de pruebas para la API REST del Sistema de Control de Citas Médicas de la Clínica Veterinaria. Incluye autenticación JWT, RBAC (ADMIN, VET, CLIENTE) y validación de las 4 reglas de negocio obligatorias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "mascotaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "citaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Autenticación",
      "item": [
        {
          "name": "Login - ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"token_admin\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Token ADMIN guardado exitosamente\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@veterinaria.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - VET",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"token_vet\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Token VET guardado exitosamente\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vet@veterinaria.com\",\n  \"password\": \"vet123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - CLIENTE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"token_cliente\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Token CLIENTE guardado exitosamente\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@veterinaria.com\",\n  \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Registro Público (Rol CLIENTE Forzado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Nuevo Propietario\",\n  \"email\": \"nuevo.propietario@gmail.com\",\n  \"password\": \"secreto123\",\n  \"telefono\": \"555-987-6543\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Mascotas",
      "item": [
        {
          "name": "Registrar Mascota (CLIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"mascotaId\", jsonData.id);",
                  "    pm.environment.set(\"mascotaId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Max\",\n  \"especie\": \"PERRO\",\n  \"raza\": \"Labrador Retriever\",\n  \"edad\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mascotas",
              "host": ["{{baseUrl}}"],
              "path": ["mascotas"]
            }
          }
        },
        {
          "name": "Obtener Mis Mascotas (CLIENTE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mascotas/mis-mascotas",
              "host": ["{{baseUrl}}"],
              "path": ["mascotas", "mis-mascotas"]
            }
          }
        },
        {
          "name": "Consultar Mascota por ID (VET o ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mascotas/{{mascotaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mascotas", "{{mascotaId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Citas Médicas",
      "item": [
        {
          "name": "Crear Cita Médica (CLIENTE o ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"citaId\", jsonData.id);",
                  "    pm.environment.set(\"citaId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarioId\": 2,\n  \"fechaHora\": \"2026-10-25T10:00:00\",\n  \"motivo\": \"Consulta de control general y vacunación\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/citas",
              "host": ["{{baseUrl}}"],
              "path": ["citas"]
            }
          }
        },
        {
          "name": "Regla 1: Intentar Cita Solapada a las 10:15 (Debe Fallar 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarioId\": 2,\n  \"fechaHora\": \"2026-10-25T10:15:00\",\n  \"motivo\": \"Intento de cita solapada que debe fallar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/citas",
              "host": ["{{baseUrl}}"],
              "path": ["citas"]
            }
          }
        },
        {
          "name": "Regla 3: Cancelar Cita (> 2 horas antes)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/{{citaId}}/cancelar",
              "host": ["{{baseUrl}}"],
              "path": ["citas", "{{citaId}}", "cancelar"]
            }
          }
        },
        {
          "name": "Consultar Agenda (VET o ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/agenda?fecha=2026-10-25&veterinarioId=2",
              "host": ["{{baseUrl}}"],
              "path": ["citas", "agenda"],
              "query": [
                {
                  "key": "fecha",
                  "value": "2026-10-25"
                },
                {
                  "key": "veterinarioId",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar Agenda por CLIENTE (Debe Fallar 403 Forbidden)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/agenda",
              "host": ["{{baseUrl}}"],
              "path": ["citas", "agenda"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Expedientes Clínicos",
      "item": [
        {
          "name": "Regla 4: Registrar Expediente (VET) y Completar Cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"citaId\": {{citaId}},\n  \"diagnostico\": \"Dermatitis alérgica por picadura de pulga\",\n  \"tratamiento\": \"Antihistamínico 10mg cada 24 horas y baño medicado por 10 días\",\n  \"pesoKg\": 28.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expedientes",
              "host": ["{{baseUrl}}"],
              "path": ["expedientes"]
            }
          }
        },
        {
          "name": "Regla 4: Registrar Segundo Expediente en Misma Cita (Debe Fallar 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"citaId\": {{citaId}},\n  \"diagnostico\": \"Intento de duplicar expediente\",\n  \"tratamiento\": \"No permitido\",\n  \"pesoKg\": 28.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expedientes",
              "host": ["{{baseUrl}}"],
              "path": ["expedientes"]
            }
          }
        },
        {
          "name": "Consultar Historial Clínico de Mascota",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expedientes/mascota/{{mascotaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expedientes", "mascota", "{{mascotaId}}"]
            }
          }
        }
      ]
    }
  ]
}
